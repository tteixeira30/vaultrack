# Caddy obtém e renova o certificado HTTPS sozinho para o teu domínio.
{$DOMAIN} {
	encode gzip

	# HTTPS sempre: o browser deixa de tentar http:// neste domínio durante um ano.
	# Fica só aqui (e não no nginx) porque em desenvolvimento não há HTTPS.
	header Strict-Transport-Security "max-age=31536000"
	header -Server

	# Access log em JSON no stdout (o Caddy já esconde o Authorization).
	# Os ficheiros estáticos com hash não interessam e só fazem ruído.
	log {
		output stdout
		format json
	}
	log_skip /assets/*

	# pedidos à API vão para o backend Spring
	handle /api/* {
		reverse_proxy backend:8080
	}

	# tudo o resto é a aplicação React (servida pelo Nginx)
	handle {
		reverse_proxy frontend:8080
	}
}
