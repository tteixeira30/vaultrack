# Configuração do scripts/deploy.ps1 — copia para ".env.deploy" e preenche.
# O ".env.deploy" é local (está no .gitignore): não o comites nem partilhes.
#
#   Copy-Item .env.deploy.example .env.deploy

# IP ou hostname da VM de produção.
# Nota: na Oracle Cloud o IP público é ephemeral — se pararmos/ligarmos a máquina,
# muda e é preciso atualizar aqui (e no DuckDNS).
VM_HOST=

# Utilizador SSH da VM (Ubuntu na Oracle = ubuntu).
VM_USER=ubuntu

# Caminho completo para a chave privada SSH no PC.
SSH_KEY=

# Porta SSH (raramente diferente de 22).
SSH_PORT=22

# Pasta do projeto dentro da VM.
REMOTE_DIR=~/Tracky

# Branch que representa produção.
BRANCH=main

# Ficheiro compose usado na VM.
COMPOSE_FILE=docker-compose.prod.yml

# Domínio público da app — usado só para o health check no fim do deploy.
# Deixa vazio para saltar essa verificação.
DOMAIN=
